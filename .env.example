# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=

# Canonical application origin used by every authentication redirect.
APP_URL=http://127.0.0.1:3000

# Add this exact URI to the Spotify app's redirect allowlist.
# Spotify requires 127.0.0.1 rather than localhost for local HTTP callbacks.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Generate with: openssl rand -base64 32
AUTH_SECRET=
